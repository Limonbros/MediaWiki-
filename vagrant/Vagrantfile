require 'json'

config_file = File.join(File.dirname(__FILE__), '..', 'config.json')

unless File.exist?(config_file)
  puts "Config file config.json not found at #{config_file}!"
  exit 1
end

config_data = JSON.parse(File.read(config_file))

# Зеркало для образов
ENV['VAGRANT_SERVER_URL'] = 'https://vagrant.elab.pro'

Vagrant.configure('2') do |config|
  config.vm.box = 'ubuntu/jammy64'
  config.ssh.insert_key = false
  config.vm.boot_timeout = 1800

  # Отключаем автообновление Guest Additions 
  if Vagrant.has_plugin?('vagrant-vbguest')
    config.vbguest.auto_update = false
    config.vbguest.no_install = true
    config.vbguest.no_remote = true
  end

  config.vm.provider 'virtualbox' do |vb|
    vb.gui = false
  end

  # Проходим по vms из config.json
  config_data['vms'].each do |vm_name, vm_config|
    config.vm.define vm_name do |vm|
      vm.vm.hostname = vm_name

      # Статический IP 
      if vm_config['ip']
        vm.vm.network 'private_network', ip: vm_config['ip']
      end

      # Ресурсы VirtualBox
      vm.vm.provider 'virtualbox' do |vb_inner|
        vb_inner.name = vm_config['name'] if vm_config['name']
        vb_inner.memory = vm_config['memory'] if vm_config['memory']
        vb_inner.cpus = vm_config['cpus'] if vm_config['cpus']
      end

      # --- Ansible provisioner ---
      # Выбираем плейбук в зависимости от имени машины
      playbook_path = case vm_name
                      when /^db-/i
                        'playbook-db.yml'
                      when /^mediawiki/i
                        'playbook-mediawiki.yml'
                      else
                        # Если машина не db и не mediawiki — можно пропустить или указать дефолт
                        nil
                      end

      if playbook_path && File.exist?(playbook_path)
        vm.vm.provision 'ansible' do |ansible|
          ansible.playbook = playbook_path
          # Ansible сам подставит ansible_host из SSH-конфига Vagrant
          # inventory не нужен: Vagrant генерирует его на лету
          ansible.limit = vm_name
      
        end
      else
        puts "Warning: No matching playbook found for VM #{vm_name} or file does not exist."
      end
    end
  end
end
